# Server-only watsonx.ai settings. Leave GRANITE_MODE=fallback until the team
# verifies credentials, region, and a currently available Granite model.
GRANITE_MODE=fallback
# Vercel production and preview deployments require this explicit opt-in. Leave
# it false unless the host has request throttling and spend limits for the
# unauthenticated route. Local live tests use the operator's own credentials.
GRANITE_ALLOW_PUBLIC_LIVE=false
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=

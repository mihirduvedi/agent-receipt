# Server-only watsonx.ai settings. Leave GRANITE_MODE=fallback until the team
# verifies credentials, region, and a currently available Granite model.
GRANITE_MODE=fallback
# Public production deployments require this additional explicit opt-in. Leave
# it false until the deployed candidate has passed credentialed live checks.
GRANITE_ALLOW_PUBLIC_LIVE=false
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=
